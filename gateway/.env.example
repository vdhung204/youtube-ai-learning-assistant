# Server-only secrets. Never prefix either value with VITE_ and never put them in the extension.
GEMINI_API_KEY=replace-with-a-google-ai-studio-key

# Server policy; the extension cannot choose a model.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=1

# One or more exact extension origins, separated by commas.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# Optional distributed rate limiting. Configure both variables or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
