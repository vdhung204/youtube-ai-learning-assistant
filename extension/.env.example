# Public URL of the deployed AI Gateway. Do not put a provider API key in this file.
VITE_YALA_GATEWAY_URL=https://your-ai-gateway.vercel.app

# Optional public Chrome extension key for a stable unpacked-extension ID across machines.
# This is public key material, not a secret. Omit it for Chrome Web Store builds.
VITE_YALA_EXTENSION_PUBLIC_KEY=
